[MASTER]
load-plugins=chromite.cli.cros.lint

[MESSAGES CONTROL]
disable=
    broad-except,
    fixme,
    file-ignored,
    invalid-name,
    locally-disabled,
    locally-enabled,
    missing-docstring,
    no-member,
    no-self-use,
    redefined-variable-type,
    relative-import,
    too-few-public-methods,
    too-many-arguments,
    too-many-boolean-expressions,
    too-many-branches,
    too-many-instance-attributes,
    too-many-lines,
    too-many-locals,
    too-many-nested-blocks,
    too-many-public-methods,
    too-many-return-statements,
    too-many-statements,
    wrong-import-order,
    wrong-import-position,

[REPORTS]
output-format=parseable
reports=no

[FORMAT]
max-line-length=80
indent-string='  '

[BASIC]
bad-functions=apply,input

[SIMILARITIES]
min-similarity-lines=20

[VARIABLES]
dummy-variables-rgx=_|unused_
